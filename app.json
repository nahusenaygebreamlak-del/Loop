{
  "expo": {
    "name": "Loop",
    "slug": "loop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.loop.planner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6BE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.loop.planner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6BE3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#2F6BE3",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2F6BE3",
          "defaultChannel": "checkins",
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "scheme": "loop",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "73134e4e-33e8-4cd2-9baa-09ac00feccae"
      }
    },
    "owner": "nahu0024"
  }
}
