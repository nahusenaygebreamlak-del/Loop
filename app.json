{
  "expo": {
    "name": "Loop",
    "slug": "loop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.loop.planner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6BE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.loop.planner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6BE3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#2F6BE3",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2F6BE3",
          "defaultChannel": "checkins",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans_600SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans_700Bold.ttf",
            "./assets/fonts/PlusJakartaSans_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "LoopToday",
              "label": "Loop \u00b7 Today",
              "description": "Today's tasks. Tick to finish, + to add.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget-preview/today.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "LoopMonth",
              "label": "Loop \u00b7 Month",
              "description": "This month at a glance.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/month.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LoopAdd",
              "label": "Loop \u00b7 Add task",
              "description": "Add a task or dump a note.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/add.png"
            }
          ]
        }
      ]
    ],
    "scheme": "loop",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "73134e4e-33e8-4cd2-9baa-09ac00feccae"
      }
    },
    "owner": "nahu0024"
  }
}
