{
  "name": "Loop · Style A · Clear blue",
  "font": {
    "family": "Plus Jakarta Sans",
    "weights": [400, 500, 600, 700, 800],
    "scale": {
      "display": { "size": 36, "weight": 800, "lineHeight": 1.1, "letterSpacing": "-0.02em", "use": "Screen titles (Today, Inbox, Work)" },
      "title": { "size": 32, "weight": 800, "lineHeight": 1.2, "use": "Full-screen moments (check-in, Check-ins are on)" },
      "detailTitle": { "size": 26, "weight": 800, "lineHeight": 1.25, "use": "Task details, note editor" },
      "sheetTitle": { "size": 22, "weight": 800, "use": "Bottom-sheet titles" },
      "cardTitle": { "size": 16, "weight": 700, "lineHeight": 1.3, "use": "Task and event titles" },
      "body": { "size": 15.5, "weight": 500, "lineHeight": 1.55 },
      "secondary": { "size": 14, "weight": 500, "use": "Time / list line under titles" },
      "label": { "size": 14, "weight": 700, "use": "Group labels (Today · 2)" },
      "caption": { "size": 13, "weight": 600 },
      "button": { "size": 16, "weight": 800 },
      "lockClock": { "size": 76, "weight": 300 }
    }
  },
  "color": {
    "light": {
      "ground": "#F2F4F9",
      "card": "#FFFFFF",
      "text": "#141A2E",
      "textSecondary": "#636B80",
