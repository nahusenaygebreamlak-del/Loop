      "checkEmpty": "#C9D2E3",
      "fill": "#E9EDF5",
      "segmentTrack": "#E4E8F1",
      "tint": "#DCE6FB",
      "accent": "#2F6BE3",
      "accentText": "#2F6BE3",
      "accentPressed": "#1F55C4",
      "onAccent": "#FFFFFF",
      "onAccentSecondary": "#DDE7FC",
      "danger": "#C7372F",
      "dangerText": "#C7372F",
      "dangerTint": "#FBE3E1",
      "snackbar": "#141A2E",
      "snackbarText": "#FFFFFF",
      "snackbarSecondary": "#A9B3C9",
      "snackbarAction": "#8FB0FF",
      "backdrop": "#8E95A6",
      "lockScreen": "#1E2A4A",
      "lockScreenText": "#C8D3EE",
      "eventFill": "#E4E8F1",
      "eventText": "#4A5266",
      "eventDot": "#9AA3B5",
      "taskBlock": "#DCE6FB",
      "nowLine": "#C7372F",
      "keyboard": "#DCE1EB"
    },
    "dark": {
      "ground": "#0F1320",
      "card": "#1A2030",
      "text": "#E8ECF5",
