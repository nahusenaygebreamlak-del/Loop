      "onAccentSecondary": "#DDE7FC",
      "danger": "#C7372F",
      "dangerText": "#FF7D72",
      "dangerRing": "#E5544A",
      "dangerTint": "#3A1E22",
      "snackbar": "#2C3550",
      "snackbarText": "#FFFFFF",
      "snackbarSecondary": "#A9B3C9",
      "snackbarAction": "#8FB0FF",
      "backdrop": "#05070D",
      "lockScreen": "#070B16",
      "lockScreenText": "#C8D3EE",
