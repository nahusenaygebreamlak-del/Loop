    "lists": {
      "work": "#2F6BE3",
      "personal": "#E0913A",
      "learning": "#3A9E7A",
      "purple": "#7A4FD6",
      "pink": "#D2467E",
      "slate": "#5B6478"
    },
    "priority": {
      "high": "#C7372F",
      "medium": "#D9822B",
      "low": "#2F6BE3",
      "none": "#C9D2E3",
      "note": "Priority is shown only as the check-ring colour. In dark mode use dangerRing for high and line for none."
    }
